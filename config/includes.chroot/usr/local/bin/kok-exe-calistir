#!/bin/bash
mkdir -p "$HOME/.local/state/kok"; exec > >(tee -a "$HOME/.local/state/kok/kok-exe-calistir.log") 2>&1; echo "--- $(date '+%F %T') $0 $*"
# Kök Uygulama Sarmalayıcı: her .exe için ayrı ve izole Wine prefix'i kullanır.
DOSYA="$1"
if [ -z "$DOSYA" ] || [ ! -f "$DOSYA" ]; then
  zenity --error --title="Kök OS" --text="Çalıştırılacak program bulunamadı." 2>/dev/null
  exit 1
fi
if ! command -v wine >/dev/null 2>&1; then
  zenity --error --title="Kök OS" --text="Windows uyumluluk katmanı (Wine) bu sistemde kurulu değil." 2>/dev/null
  exit 1
fi
AD=$(basename "$(dirname "$(readlink -f "$DOSYA")")" | tr -c 'A-Za-z0-9\n' '_')
HASH=$(readlink -f "$DOSYA" | md5sum | cut -c1-6)
export WINEPREFIX="$HOME/.local/share/kok-wine/${AD}_${HASH}"
export WINEDEBUG=err+all
export WINEDLLOVERRIDES="winemenubuilder.exe=d"
if [ ! -d "$WINEPREFIX" ]; then
  notify-send "Kök OS" "Bu program için ilk kez ortam hazırlanıyor. Biraz sürebilir…" 2>/dev/null
  wineboot -u >/dev/null 2>&1
fi
cd "$(dirname "$DOSYA")" || exit 1
case "${DOSYA,,}" in
  *.msi) wine msiexec /i "$DOSYA" ;;
  *)     wine start /unix "$DOSYA" ;;
esac
KOD=$?
if [ $KOD -ne 0 ]; then
  zenity --warning --title="Kök OS" --text="Bu program beklendiği gibi çalışmadı.\n\nBazı Windows programları (özellikle ağır oyunlar ve korumalı yazılımlar) uyumlu olmayabilir.\n\nÇıkış kodu: $KOD" 2>/dev/null
fi
exit $KOD
