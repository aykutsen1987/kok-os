#!/bin/bash
# /usr/share/kok/apk içindeki APK'ları Android'e önyükler (ilk kurulumdan sonra).
mkdir -p "$HOME/.local/state/kok"; exec > >(tee -a "$HOME/.local/state/kok/kok-android-onyukle.log") 2>&1; echo "--- $(date '+%F %T') $0"
ls /usr/share/kok/apk/*.apk >/dev/null 2>&1 || { echo "Önyüklenecek APK yok."; exit 0; }
pkexec systemctl start waydroid-container.service
waydroid session start >/dev/null 2>&1 &
for i in $(seq 1 30); do waydroid status 2>/dev/null | grep -q RUNNING && break; sleep 2; done
for a in /usr/share/kok/apk/*.apk; do
  echo "Kuruluyor: $a"
  if waydroid app install "$a"; then echo "[KOK:A7:onyukle] TAMAM $a"; else echo "[KOK-HATA:A7:onyukle] $a"; fi
done
