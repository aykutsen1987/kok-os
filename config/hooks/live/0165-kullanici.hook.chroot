#!/bin/sh
KOK_ADIM="A13b"; KOK_MOD="kullanici"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
chmod +x /usr/local/sbin/kok-kullanici-hazirla
/usr/local/sbin/kok-kullanici-hazirla hemen
if id kok >/dev/null 2>&1; then
  echo "[KOK:$KOK_ADIM:$KOK_MOD] kok kullanicisi olusturuldu: $(id kok)"
else
  echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kok kullanicisi OLUSTURULAMADI"
fi
exit 0
