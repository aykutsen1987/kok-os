#!/bin/bash
# Kök Hata Raporu: her bölüm hangi ADIMA ait olduğu başlıkta yazar.
export PATH=$PATH:/usr/sbin:/sbin
TARIH=$(date +%Y%m%d-%H%M%S)
CIKTI="$HOME/kok-rapor-$TARIH.txt"
S=""; sudo -n true 2>/dev/null && S="sudo -n"
bolum(){ echo; echo "=================================================="; echo "=== $1"; echo "=================================================="; }
komut(){ echo "\$ $*"; "$@" 2>&1 | tail -n "${SATIR:-60}"; echo; }
{
bolum "[GENEL] Sürüm ve donanım"
cat /etc/kok/surum 2>/dev/null || echo "UYARI: /etc/kok/surum yok (Adım 5 hook'u çalışmamış)"
komut uname -a
komut grep PRETTY_NAME /etc/os-release
komut free -m
komut bash -c "lscpu | grep -E 'Model name|Flags' | cut -c1-120"
komut bash -c "lspci -nn | grep -Ei 'vga|3d|network'"
komut cat /tmp/kok/profil
komut id
komut cat /proc/cmdline

bolum "[SAĞLIK ÖZETİ – adım adım TAMAM/SORUN]"
/usr/local/bin/kok-saglik 2>&1

bolum "[ADIM 2] Çekirdek, bellek, yerelleştirme, servisler (hook: 0010, 0020)"
komut zramctl
komut swapon --show
komut sysctl vm.swappiness vm.vfs_cache_pressure
komut systemctl is-active earlyoom fstrim.timer systemd-timesyncd
komut systemctl --failed --no-pager
komut locale
komut localectl status
SATIR=80 komut $S journalctl -p 3 -b --no-pager
SATIR=60 komut $S dmesg -l err,warn

bolum "[ADIM 3] Masaüstü, tema, rıhtım (hook: 0030)"
komut bash -c "pgrep -a plank; pgrep -a xfwm4; pgrep -a xfce4-panel"
komut xfconf-query -c xsettings -p /Net/ThemeName
komut xfconf-query -c xsettings -p /Net/IconThemeName
komut xfconf-query -c xfwm4 -p /general/use_compositing
komut bash -c "ls -d /usr/share/themes/WhiteSur* /usr/share/icons/WhiteSur* 2>&1"
komut bash -c "grep -E '\(EE\)' /var/log/Xorg.0.log ~/.local/share/xorg/Xorg.0.log 2>/dev/null"
SATIR=40 komut $S tail -n 40 /var/log/lightdm/lightdm.log
SATIR=40 komut tail -n 40 ~/.xsession-errors

bolum "[ADIM 4a] Windows uyumluluğu – Wine (hook: 0040, araç: kok-exe-calistir)"
komut wine --version
komut dpkg --print-foreign-architectures
komut ls -la ~/.local/share/kok-wine
SATIR=80 komut tail -n 80 ~/.local/state/kok/kok-exe-calistir.log

bolum "[ADIM 4b] Android – Waydroid (hook: 0050, araçlar: kok-android-*, kok-apk-kur)"
komut /usr/local/bin/kok-android-kontrol
komut bash -c "grep -w binder /proc/filesystems; lsmod | grep -i binder"
komut waydroid --version
komut $S waydroid status
komut systemctl status waydroid-container --no-pager
SATIR=80 komut $S tail -n 80 /var/lib/waydroid/waydroid.log
for L in kok-android-kurulum kok-android-kopru kok-apk-kur; do echo "--- $L.log"; tail -n 40 ~/.local/state/kok/$L.log 2>&1; done

bolum "[ADIM 5] Kurulum sihirbazı – Calamares (hook: 0060, 0070)"
komut bash -c "ls /etc/calamares/branding/kok /etc/calamares/modules 2>&1"
komut grep -E '^branding' /etc/calamares/settings.conf
SATIR=150 komut $S bash -c "tail -n 150 /root/.cache/calamares/session.log 2>/dev/null || tail -n 150 ~/.cache/calamares/session.log"

bolum "[ADIM 6] Görünüm, panel, rıhtım, Kök Ayarlar (hook: 0080, araç: kok-ayarlar)"
komut dconf dump /net/launchpad/plank/
komut bash -c "ls ~/.config/plank/dock1/launchers ~/.config/xfce4/panel 2>&1"
komut xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids
SATIR=30 komut tail -n 30 /usr/share/kok/whitesur-gtk.log
komut bash -c "ls -la /etc/skel/.config 2>&1; ls /usr/share/kok/skel-config 2>&1"
SATIR=40 komut tail -n 40 ~/.local/state/kok/kok-ayarlar.log
komut bash -c "ls /usr/share/applications | grep -iE 'install|calamares|kok'"

bolum "[ADIM 7] Android kataloğu, önyüklü uygulamalar, açılış markası (hook: 0090, 0100; araç: kok-uygulamalar)"
komut cat /etc/kok/android-katalog.conf
komut bash -c "python3 -m json.tool /usr/share/kok/android-katalog.json > /dev/null && echo 'gomulu katalog GECERLI'"
komut bash -c "ls -la /usr/share/kok/apk ~/.cache/kok ~/.cache/kok/apk 2>&1"
komut bash -c "waydroid app list 2>&1 | grep -E 'Name|packageName'"
SATIR=40 komut tail -n 40 ~/.local/state/kok/kok-uygulamalar.log
SATIR=40 komut tail -n 40 ~/.local/state/kok/kok-android-onyukle.log
SATIR=30 komut tail -n 30 ~/.local/state/kok/kok-android-ac.log
komut bash -c "cat /proc/cmdline; ls /run/live/medium 2>&1"

bolum "[ADIM 8] Karşılama, sağlık kontrolü, hazır uygulamalar (hook: 0110; araçlar: kok-karsilama, kok-saglik)"
SATIR=40 komut tail -n 40 ~/.local/state/kok/kok-karsilama.log
komut bash -c "ls ~/.config/kok 2>&1; ls /etc/xdg/autostart | grep -i kok"
komut bash -c "for p in vlc evince galculator xfce4-taskmanager soffice; do printf '%s: ' $p; command -v $p || echo YOK; done"
komut bash -c "du -sh /usr/share/kok 2>&1"

bolum "[ADIM 9] Performans ve sanal makine (araç: kok-performans)"
SATIR=40 komut /usr/local/bin/kok-performans
komut bash -c "pgrep -a VBoxClient; lsmod | grep -i vbox; dpkg -l | grep -i virtualbox | cut -c1-80; ls /media"
komut cat /etc/udev/rules.d/60-kok-disk.rules

bolum "[ADIM 10] Donanım: dokunmatik, döndürme, Wi-Fi, Bluetooth, pil (araç: kok-donder)"
komut bash -c "xinput list 2>&1 | head -25"
komut bash -c "ls /sys/bus/iio/devices 2>&1; ls /sys/class/power_supply 2>&1"
komut bash -c "nmcli device 2>&1; rfkill list 2>&1"
komut systemctl is-active tlp iio-sensor-proxy bluetooth
komut cat /etc/X11/xorg.conf.d/40-kok-libinput.conf
SATIR=30 komut tail -n 30 ~/.local/state/kok/kok-donder.log

bolum "[ADIM 11] Güncelleme (araç: kok-guncelle)"
komut cat /etc/kok/guncelleme.conf
komut cat /etc/apt/apt.conf.d/20auto-upgrades
SATIR=30 komut tail -n 30 ~/.local/state/kok/kok-guncelle.log

bolum "[ADIM 12] Sürüm, kılavuz, genel"
komut cat /etc/kok/surum
komut bash -c "ls -la /usr/share/kok; head -3 /etc/os-release"
komut bash -c "ls ~/.local/state/kok"

bolum "[ADIM 13] Kimlik, dil, katalog, yuvarlak köşeler (araçlar: kok-hakkinda, kok-dil, kok-uygulamalar, picom)"
komut bash -c "cat /etc/default/locale; locale -a | head -8; echo LANG=$LANG"
komut bash -c "pgrep -a picom; ls -la ~/.config/kok 2>&1"
SATIR=30 komut tail -n 30 ~/.local/state/kok/picom.log
SATIR=30 komut tail -n 30 ~/.local/state/kok/kok-hakkinda.log
SATIR=30 komut tail -n 30 ~/.local/state/kok/kok-dil.log
komut cat /etc/kok/android-katalog.conf
komut bash -c "ls ~/.config/xfce4/panel/launcher-10 ~/Desktop 2>&1"
komut cat /etc/kok/geri-bildirim.conf
komut bash -c "cat /etc/lightdm/lightdm.conf.d/*.conf; ls /etc/polkit-1/rules.d; sudo -n true && echo SUDO_PAROLASIZ_TAMAM"

bolum "[GIRIS TANISI] Otomatik giriş / giriş ekranı sorunu (lightdm, oturum)"
komut bash -c "echo GIRIS TANISI; id kok; getent group sudo nopasswdlogin autologin vboxsf; grep '^kok:' /etc/passwd"
SATIR=60 komut $S journalctl -b -u lightdm --no-pager
SATIR=40 komut $S bash -c "ls -la /var/log/lightdm; tail -n 40 /var/log/lightdm/seat0-greeter.log"
SATIR=30 komut $S bash -c "tail -n 30 /var/log/lightdm/x-0.log"
SATIR=40 komut bash -c "tail -n 40 ~/.xsession-errors"
komut $S chage -l kok
komut $S bash -c "grep '^kok:' /etc/shadow | cut -d: -f1,3-9"
komut bash -c "loginctl list-sessions --no-pager; systemctl is-active kok-canli-parola.service live-config.service"
komut bash -c "grep -n . /etc/lightdm/lightdm.conf /etc/lightdm/lightdm.conf.d/*.conf 2>/dev/null"
} > "$CIKTI" 2>&1
PANO=""; PAYLASIM=""
if command -v xclip >/dev/null && [ -n "$DISPLAY" ]; then xclip -selection clipboard < "$CIKTI" 2>/dev/null && PANO="Rapor panoya kopyalandı (Ctrl+V)."; fi
for d in /media/sf_* /mnt/rapor; do
  if [ -d "$d" ] && sudo -n cp "$CIKTI" "$d/" 2>/dev/null; then PAYLASIM="Paylaşılan klasöre de kopyalandı: $d"; fi
done
if [ -z "$KOK_SESSIZ" ] && command -v zenity >/dev/null; then
  zenity --info --title="Kök OS" --width=420 --text="Rapor hazır:\n$CIKTI\n$PANO\n$PAYLASIM\n\nBu dosyanın içeriğini geliştiriciye gönderin." 2>/dev/null
fi
echo "$CIKTI"
