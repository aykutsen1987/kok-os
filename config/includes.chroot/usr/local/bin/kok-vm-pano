#!/bin/bash
# VirtualBox içinde konuk hizmetlerini (pano, sürükle-bırak, ekran) başlatır.
[ "$(systemd-detect-virt 2>/dev/null)" = "oracle" ] || exit 0
command -v VBoxClient >/dev/null 2>&1 || exit 0
mkdir -p "$HOME/.local/state/kok"
{
  VBoxClient --clipboard
  VBoxClient --draganddrop
  VBoxClient --vmsvga
} >>"$HOME/.local/state/kok/kok-vm-pano.log" 2>&1
exit 0
