#!/bin/bash
# Kök Sağlık Kontrolü: her adımın çalışıp çalışmadığını Türkçe özetler.
mkdir -p /tmp/kok; OUT=/tmp/kok/saglik.txt
OKS=0; SORUN=0
ok(){ echo "  [TAMAM]  $1"; OKS=$((OKS+1)); }
sorun(){ echo "  [SORUN]  $1  -> ilgili: $2"; SORUN=$((SORUN+1)); }
bilgi(){ echo "  [BİLGİ]  $1"; }
baslik(){ echo; echo "== $1 =="; }
kontrol(){ local a="$1" i="$2"; shift 2; if "$@" >/dev/null 2>&1; then ok "$a"; else sorun "$a" "$i"; fi; }
calistir(){
echo "Kök Sağlık Kontrolü – $(date '+%F %T')   Profil: $(cat /tmp/kok/profil 2>/dev/null || echo ?)"

baslik "ADIM 2 – Çekirdek, bellek, dil"
kontrol "ZRAM etkin" "hook 0020, zram-generator.conf" bash -c "zramctl | grep -q zram0"
kontrol "earlyoom çalışıyor" "paket earlyoom, hook 0020" systemctl is-active --quiet earlyoom
kontrol "swappiness ayarı (150)" "sysctl.d/99-kok.conf" bash -c '[ "$(sysctl -n vm.swappiness)" = 150 ]'
kontrol "Türkçe dil (tr_TR)" "hook 0010" bash -c "locale | grep -q tr_TR"
kontrol "Türkçe Q klavye" "/etc/default/keyboard" bash -c "setxkbmap -query | grep -q 'layout:.*tr'"
if timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -q yes; then ok "Saat eşitlendi (NTP)"; else bilgi "Saat henüz eşitlenmedi (internet yoksa normal)"; fi

baslik "ADIM 3 – Masaüstü ve tema"
kontrol "Xfce paneli çalışıyor" "xfce4-panel.xml (adım 6)" pgrep -x xfce4-panel
kontrol "Pencere yöneticisi çalışıyor" "xfwm4" pgrep -x xfwm4
kontrol "Rıhtım (Plank) çalışıyor" "autostart/plank.desktop, dconf" pgrep -x plank
if [ -d /usr/share/themes/WhiteSur-Dark ]; then ok "WhiteSur GTK teması kurulu"; else bilgi "WhiteSur GTK yok, Arc teması kullanılıyor (hook 0030 çıktısına bak)"; fi
bilgi "Simge teması: $(xfconf-query -c xsettings -p /Net/IconThemeName 2>/dev/null)"

baslik "ADIM 4 – Windows (Wine) ve Android (Waydroid)"
kontrol "Wine kurulu" "hook 0040" command -v wine
bilgi "Wine sürümü: $(wine --version 2>/dev/null || echo yok)"
kontrol "32-bit (i386) desteği" "hook 0040" bash -c "dpkg --print-foreign-architectures | grep -q i386"
kontrol "Waydroid kurulu" "hook 0050 (resmi depo)" command -v waydroid
kontrol "cage (Android penceresi) kurulu" "hook 0050" command -v cage
if grep -qw binder /proc/filesystems 2>/dev/null; then ok "Çekirdekte binder desteği var"; else bilgi "binder yok: sanal makinede normal, gerçek donanımda kontrol edin"; fi
if [ -f /var/lib/waydroid/waydroid.cfg ]; then ok "Android ortamı kurulmuş"; else bilgi "Android ortamı henüz kurulmadı (isteğe bağlı)"; fi

baslik "ADIM 5 – Kurulum sihirbazı ve marka"
kontrol "Calamares kurulu" "paket calamares" command -v calamares
kontrol "Kök marka dosyası" "branding/kok" test -f /etc/calamares/branding/kok/branding.desc
kontrol "Calamares markası 'kok'" "hook 0060" grep -q '^branding: *kok' /etc/calamares/settings.conf
kontrol "Sistem adı Kök OS" "hook 0070" grep -q 'Kök OS' /etc/os-release
kontrol "Hata raporu aracı" "kok-hata-raporu" test -x /usr/local/bin/kok-hata-raporu

baslik "ADIM 6 – Görünüm ve Kök Ayarlar"
kontrol "Duvar kâğıdı dosyası" "usr/share/backgrounds/kok" test -f /usr/share/backgrounds/kok/kok-duvar.png
kontrol "Panel yapılandırması" "xfce4-panel.xml" test -f /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
kontrol "Rıhtım büyütme kapalı (dconf)" "dconf/00-kok, hook 0080" bash -c "dconf read /net/launchpad/plank/docks/dock1/zoom-enabled | grep -q false"
kontrol "Kök Ayarlar kod olarak geçerli" "kok-ayarlar" python3 -c "import ast;ast.parse(open('/usr/local/bin/kok-ayarlar').read())"
if grep -qs '^Hidden=true' /usr/share/applications/install-debian.desktop || [ ! -f /usr/share/applications/install-debian.desktop ]; then ok "'Install Debian' kısayolu gizli"; else sorun "'Install Debian' kısayolu görünür" "hook 0080"; fi

baslik "ADIM 7 – Android kataloğu ve açılış markası"
kontrol "Gömülü katalog (JSON) geçerli" "android-katalog.json" python3 -m json.tool /usr/share/kok/android-katalog.json
kontrol "Katalog ayar dosyası" "etc/kok/android-katalog.conf" test -f /etc/kok/android-katalog.conf
kontrol "Katalog aracı geçerli" "kok-uygulamalar" python3 -c "import ast;ast.parse(open('/usr/local/bin/kok-uygulamalar').read())"
bilgi "Önyüklü APK sayısı: $(ls /usr/share/kok/apk/*.apk 2>/dev/null | wc -l)"
bilgi "Katalog adresi: $(grep '^KATALOG_URL=' /etc/kok/android-katalog.conf 2>/dev/null | cut -d= -f2)"

baslik "ADIM 8 – Karşılama, sağlık, hazır uygulamalar"
kontrol "Karşılama aracı geçerli" "kok-karsilama" python3 -c "import ast;ast.parse(open('/usr/local/bin/kok-karsilama').read())"
for p in vlc evince galculator xfce4-taskmanager soffice; do kontrol "Uygulama kurulu: $p" "kok-uygulamalar.list.chroot" command -v $p; done

baslik "Ağ"
if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; then ok "İnternet bağlantısı var"; else sorun "İnternet bağlantısı yok" "NetworkManager / VM ağ ayarı"; fi

echo
echo "ÖZET: $OKS tamam, $SORUN sorun. (BİLGİ satırları hata değildir)"
}
calistir 2>&1 | tee "$OUT"
if [ "$1" = "--gui" ] && command -v zenity >/dev/null; then
  zenity --text-info --title="Kök Sağlık Kontrolü" --width=700 --height=560 --filename="$OUT" 2>/dev/null
fi
