#!/bin/sh
# Android uygulama simgelerini ISO derlenirken indirir (çevrimdışı da görünsün); olmazsa genel simge kullanılır.
KOK_ADIM="A7"; KOK_MOD="ikonlar"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
mkdir -p /usr/share/kok/ikonlar
python3 - <<'PY'
import io, json, os, urllib.request
from concurrent.futures import ThreadPoolExecutor
try:
    from PIL import Image
except Exception:
    print("[KOK-UYARI:A7:ikonlar] Pillow yok; simgeler cevrimici indirilecek")
    raise SystemExit(0)
KAT = "/usr/share/kok/android-katalog.json"
HEDEF = os.environ.get("KOK_IKON_DIZIN", "/usr/share/kok/ikonlar")
try:
    uyg = json.load(open(KAT, encoding="utf-8")).get("uygulamalar", [])
except Exception as e:
    print("[KOK-UYARI:A7:ikonlar] katalog okunamadi:", e); raise SystemExit(0)

def indir(u):
    paket, url = u.get("paket", ""), u.get("ikon", "")
    if not paket or not url.startswith("https://"):
        return False
    adres = url if "=" in url.rsplit("/", 1)[-1] else url + "=s128"
    for deneme in range(3):
        try:
            istek = urllib.request.Request(adres, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) KokOS",
                                                           "Accept": "image/png,image/*;q=0.8"})
            with urllib.request.urlopen(istek, timeout=20) as r:
                veri = r.read(3_000_000)
            im = Image.open(io.BytesIO(veri)).convert("RGBA")
            im.thumbnail((128, 128))
            im.save(os.path.join(HEDEF, paket + ".png"), "PNG")
            return True
        except Exception:
            pass
    return False

with ThreadPoolExecutor(8) as havuz:
    sonuc = list(havuz.map(indir, uyg))
tamam = sum(1 for x in sonuc if x)
print("[KOK:A7:ikonlar] indirilen simge: %d / %d" % (tamam, len(uyg)))
for u, ok in zip(uyg, sonuc):
    if not ok:
        print("[KOK-UYARI:A7:ikonlar] simge yok (genel simge kullanilacak): " + u.get("ad", "?"))
PY
exit 0
