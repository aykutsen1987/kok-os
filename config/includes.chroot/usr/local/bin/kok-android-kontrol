#!/bin/bash
# 0 = Android destekleniyor; aksi halde Türkçe sebep yazar.
RAM_MB=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)
if [ "$RAM_MB" -lt 3500 ]; then
  echo "Bu bilgisayarda yeterli bellek yok (${RAM_MB} MB). Android uygulamaları için en az 4 GB RAM önerilir."; exit 1
fi
if ! command -v waydroid >/dev/null 2>&1; then
  echo "Android katmanı (Waydroid) bu sistemde kurulu değil."; exit 1
fi
if ! grep -qw binder /proc/filesystems 2>/dev/null && ! modprobe binder_linux 2>/dev/null; then
  echo "Çekirdek Android'in ihtiyaç duyduğu 'binder' desteğini sağlamıyor."; exit 1
fi
exit 0
