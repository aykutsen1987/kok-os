#!/bin/bash
# Kök OS – önyükleyici (GRUB) hazırlığı. İNTERNET GEREKTİRMEZ.
# Debian'ın özgün betiği 'apt-get install grub-pc / grub-efi' ile paketleri internetten kuruyordu;
# bağlantı yokken kurulum "Kurulum başarısız oldu" ile çöküyordu. GRUB dosyaları artık canlı sistemden gelir.

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")

# Şifreli disk (LUKS) için gerekli araçlar (özgün betikteki gibi)
if [ "$(mount | grep $CHROOT" " | cut -c -16)" = "/dev/mapper/luks" ]; then
    echo "UMASK=0077" > $CHROOT/etc/initramfs-tools/conf.d/initramfs-permissions
    chroot $CHROOT apt-get -y install cryptsetup-initramfs cryptsetup keyutils
fi

echo "Running bootloader-config (Kök OS, çevrimdışı)..."

if [ -d /sys/firmware/efi/efivars ]; then
    FW=efi;  BIN=grub-efi-amd64-bin
else
    FW=bios; BIN=grub-pc-bin
fi
echo " * donanım yazılımı türü: $FW"

# Gerekli paketler hedef sistemde var mı?
EKSIK=""
for p in grub-common grub2-common "$BIN" os-prober; do
    chroot $CHROOT dpkg -s "$p" >/dev/null 2>&1 || EKSIK="$EKSIK $p"
done
if [ "$FW" = "efi" ]; then
    for p in grub-efi-amd64-signed shim-signed efibootmgr; do
        chroot $CHROOT dpkg -s "$p" >/dev/null 2>&1 || echo " ! uyarı: $p yok (Secure Boot olmayabilir)"
    done
fi
if [ -n "$EKSIK" ]; then
    echo " ! eksik paketler:$EKSIK  -> internetten kurmayı deniyorum"
    DEBIAN_FRONTEND=noninteractive chroot $CHROOT apt-get -y install $EKSIK || {
        echo "HATA: önyükleyici dosyaları bulunamadı ve internet yok."
        exit 2
    }
fi

mkdir -p $CHROOT/boot/grub
G=$CHROOT/etc/default/grub
# /etc/default/grub normalde grub-pc/grub-efi paketlerinin kurulum betiğiyle oluşur; biz o paketleri
# kurmadığımız için dosyayı, grub2-common'un verdiği şablondan kendimiz oluşturuyoruz.
if [ ! -f "$G" ]; then
    mkdir -p $CHROOT/etc/default
    if [ -f $CHROOT/usr/share/grub/default/grub ]; then
        echo " * /etc/default/grub şablondan oluşturuluyor"
        cp $CHROOT/usr/share/grub/default/grub "$G"
    else
        echo " * /etc/default/grub yedek içerikle oluşturuluyor"
        cat > "$G" <<'GRUBVARSAYILAN'
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="Kok OS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet"
GRUB_CMDLINE_LINUX=""
GRUBVARSAYILAN
    fi
fi
if [ ! -f "$G" ]; then
    echo "HATA: /etc/default/grub oluşturulamadı"
    exit 2
fi

# Bilgisayardaki diğer işletim sistemlerini (Windows vb.) menüye ekle
if grep -q '^#\?GRUB_DISABLE_OS_PROBER' "$G"; then
    sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' "$G"
else
    echo 'GRUB_DISABLE_OS_PROBER=false' >> "$G"
fi

# Açılışta GRUB menüsü görünsün (iki işletim sistemi varsa seçim yapılabilsin)
if grep -q '^GRUB_TIMEOUT_STYLE' "$G"; then sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=menu/' "$G"; else echo 'GRUB_TIMEOUT_STYLE=menu' >> "$G"; fi
if grep -q '^GRUB_TIMEOUT=' "$G"; then sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=8/' "$G"; else echo 'GRUB_TIMEOUT=8' >> "$G"; fi

chroot $CHROOT /usr/sbin/update-grub || echo " ! uyarı: update-grub hata verdi (bootloader modülü yeniden deneyecek)"
exit 0
