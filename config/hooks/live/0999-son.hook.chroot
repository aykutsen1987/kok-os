#!/bin/sh
KOK_ADIM="A12"; KOK_MOD="son"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
ldconfig && echo "[KOK:A12:son] ld.so.cache guncel"
[ -d /etc/skel/.config/plank ] && echo "[KOK:A12:son] skel plank ayari var" || echo "[KOK-UYARI:A12:son] skel plank ayari YOK"
[ -f /etc/skel/.config/xfce4/panel/whiskermenu-1.rc ] && echo "[KOK:A12:son] skel menu ayari var" || echo "[KOK-UYARI:A12:son] skel menu ayari YOK"
command -v VBoxClient >/dev/null 2>&1 && echo "[KOK:A12:son] VBoxClient var (VM panosu calisir)" || echo "[KOK-UYARI:A12:son] VBoxClient YOK (VM panosu calismaz)"
for m in kokuyari kokbitir; do [ -f /usr/local/lib/calamares/modules/$m/main.py ] && echo "[KOK:A12:son] kurulum modulu var: $m" || echo "[KOK-UYARI:A12:son] kurulum modulu YOK: $m"; done
grep -q kokuyari /etc/calamares/settings.conf 2>/dev/null && echo "[KOK:A12:son] settings.conf kokuyari iceriyor" || echo "[KOK-UYARI:A12:son] settings.conf kokuyari ICERMIYOR"
exit 0
