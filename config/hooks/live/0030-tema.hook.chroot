#!/bin/sh
KOK_ADIM="A3"; KOK_MOD="tema"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
# WhiteSur temasını (macOS estetiği) dene; başarısız olursa Arc+Papirus kalır.
X=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml
cd /tmp
git clone --depth 1 https://github.com/vinceliuice/WhiteSur-gtk-theme.git && \
  (cd WhiteSur-gtk-theme && ./install.sh -d /usr/share/themes -c Dark) || echo "[KOK-UYARI:A3:tema] WhiteSur GTK kurulamadi, Arc kullanilacak"
git clone --depth 1 https://github.com/vinceliuice/WhiteSur-icon-theme.git && \
  (cd WhiteSur-icon-theme && ./install.sh -d /usr/share/icons) || echo "[KOK-UYARI:A3:tema] WhiteSur simge kurulamadi, Papirus kullanilacak"
if [ -d /usr/share/themes/WhiteSur-Dark ]; then
  sed -i 's/Arc-Dark/WhiteSur-Dark/g' $X/xsettings.xml $X/xfwm4.xml
fi
if [ -d /usr/share/icons/WhiteSur-dark ]; then
  sed -i 's/Papirus-Dark/WhiteSur-dark/' $X/xsettings.xml
fi
rm -rf /tmp/WhiteSur-*
exit 0
