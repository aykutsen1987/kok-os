#!/usr/bin/env python3
# Kök Ayarlar Merkezi – Türkçe sistem ayarları
import gi, os, sys, subprocess
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

LOGDIR = os.path.expanduser("~/.local/state/kok")
os.makedirs(LOGDIR, exist_ok=True)
try:
    sys.stderr = open(os.path.join(LOGDIR, "kok-ayarlar.log"), "a", buffering=1)
except Exception:
    pass
BIN = "/usr/local/bin"
PROFIL_DOSYASI = os.path.expanduser("~/.config/kok/profil")


def mesaj(baslik, metin, parent=None):
    d = Gtk.MessageDialog(parent=parent, modal=True, message_type=Gtk.MessageType.INFO,
                          buttons=Gtk.ButtonsType.OK, text=baslik)
    d.format_secondary_text(metin)
    d.run()
    d.destroy()


def calistir(args):
    try:
        subprocess.Popen(args)
    except Exception as e:
        print("HATA:", args, e, file=sys.stderr)
        mesaj("Çalıştırılamadı", "%s\n\n%s" % (" ".join(args), e))


def cikti(args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=20).stdout.strip()
    except Exception as e:
        print("HATA:", args, e, file=sys.stderr)
        return ""


def tema_var(ad):
    return os.path.isdir("/usr/share/themes/" + ad)


class Pencere(Gtk.Window):
    def __init__(self):
        super().__init__(title="Kök Ayarlar")
        self.set_default_size(520, 440)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("preferences-system")
        nb = Gtk.Notebook()
        self.add(nb)
        nb.append_page(self.genel(), Gtk.Label(label="Genel"))
        nb.append_page(self.gorunum(), Gtk.Label(label="Görünüm"))
        nb.append_page(self.windows(), Gtk.Label(label="Windows"))
        nb.append_page(self.android(), Gtk.Label(label="Android"))
        nb.append_page(self.donanim(), Gtk.Label(label="Donanım"))
        nb.append_page(self.sistem(), Gtk.Label(label="Sistem"))

    def kutu(self):
        b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        b.set_border_width(16)
        return b

    def etiket(self, kutu, metin, kalin=False):
        e = Gtk.Label(xalign=0)
        e.set_line_wrap(True)
        e.set_selectable(True)
        if kalin:
            e.set_markup("<b>%s</b>" % GLib_escape(metin))
        else:
            e.set_text(metin)
        kutu.pack_start(e, False, False, 0)
        return e

    def dugme(self, kutu, metin, fn):
        d = Gtk.Button(label=metin)
        d.connect("clicked", lambda _b: fn())
        kutu.pack_start(d, False, False, 0)
        return d

    # --- Genel ---
    def genel(self):
        b = self.kutu()
        ram = cikti(["awk", "/MemTotal/{print int($2/1024)}", "/proc/meminfo"])
        cpu = cikti(["bash", "-c", "grep -m1 'model name' /proc/cpuinfo | cut -d: -f2"])
        mevcut = ""
        try:
            mevcut = open("/tmp/kok/profil").read().strip()
        except Exception:
            pass
        self.etiket(b, "Bu bilgisayar", True)
        self.etiket(b, "İşlemci:%s\nBellek: %s MB\nAktif profil: %s" % (cpu, ram, mevcut or "bilinmiyor"))
        self.etiket(b, "Performans profili", True)
        self.etiket(b, "Hafif profil animasyonları kapatır, eski bilgisayarlarda daha akıcı çalışır.")
        self.combo = Gtk.ComboBoxText()
        for ad in ("Otomatik (önerilen)", "Hafif", "Standart"):
            self.combo.append_text(ad)
        sec = 0
        try:
            v = open(PROFIL_DOSYASI).read().strip()
            sec = {"hafif": 1, "standart": 2}.get(v, 0)
        except Exception:
            pass
        self.combo.set_active(sec)
        b.pack_start(self.combo, False, False, 0)
        self.dugme(b, "Profili Uygula", self.profil_uygula)
        self.dugme(b, "Performans Özeti", lambda: calistir([BIN + "/kok-performans", "--gui"]))
        return b

    def profil_uygula(self):
        deger = ["otomatik", "hafif", "standart"][self.combo.get_active()]
        os.makedirs(os.path.dirname(PROFIL_DOSYASI), exist_ok=True)
        if deger == "otomatik":
            try:
                os.remove(PROFIL_DOSYASI)
            except FileNotFoundError:
                pass
        else:
            open(PROFIL_DOSYASI, "w").write(deger + "\n")
        calistir([BIN + "/kok-profil"])
        mesaj("Kaydedildi", "Profil ayarı uygulandı.", self)

    # --- Görünüm ---
    def gorunum(self):
        b = self.kutu()
        self.etiket(b, "Tema", True)
        self.dugme(b, "Koyu Tema", lambda: self.tema_ayarla(True))
        self.dugme(b, "Açık Tema", lambda: self.tema_ayarla(False))
        self.etiket(b, "Duvar kâğıdı ve diğer görünüm ayarları için: Uygulamalar menüsü → Ayarlar → Masaüstü.")
        self.dugme(b, "Masaüstü Ayarlarını Aç", lambda: calistir(["xfdesktop-settings"]))
        self.dugme(b, "Rıhtım Ayarlarını Aç", lambda: calistir(["plank", "--preferences"]))
        return b

    def tema_ayarla(self, koyu):
        if koyu:
            ad = "WhiteSur-Dark" if tema_var("WhiteSur-Dark") else "Arc-Dark"
        else:
            ad = "WhiteSur-Light" if tema_var("WhiteSur-Light") else "Arc"
        cikti(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-n", "-t", "string", "-s", ad])
        cikti(["xfconf-query", "-c", "xfwm4", "-p", "/general/theme", "-n", "-t", "string", "-s", ad])
        mesaj("Tema değişti", "Uygulanan tema: " + ad, self)

    # --- Windows ---
    def windows(self):
        b = self.kutu()
        surum = cikti(["wine", "--version"]) or "Kurulu değil"
        self.etiket(b, "Windows Uyumluluğu (Wine)", True)
        self.etiket(b, "Sürüm: " + surum)
        self.etiket(b, "Bir .exe dosyasına çift tıklamak yeterlidir. Her program kendi ayrı ortamında çalışır.")
        self.dugme(b, "Bir Windows Programı Seç ve Çalıştır…", self.exe_sec)
        self.dugme(b, "Wine Ayarlarını Aç", lambda: calistir(["winecfg"]))
        self.dugme(b, "Program Ortamları Klasörünü Aç", self.prefix_ac)
        self.dugme(b, "Uyumluluk Notlarını Oku", lambda: calistir(["mousepad", "/usr/share/kok/uyumluluk.md"]))
        return b

    def prefix_ac(self):
        yol = os.path.expanduser("~/.local/share/kok-wine")
        os.makedirs(yol, exist_ok=True)
        calistir(["xdg-open", yol])

    def dosya_sec(self, baslik, desenler):
        d = Gtk.FileChooserDialog(title=baslik, parent=self, action=Gtk.FileChooserAction.OPEN)
        d.add_buttons("İptal", Gtk.ResponseType.CANCEL, "Seç", Gtk.ResponseType.OK)
        f = Gtk.FileFilter()
        f.set_name("Uygun dosyalar")
        for p in desenler:
            f.add_pattern(p)
        d.add_filter(f)
        yol = d.get_filename() if d.run() == Gtk.ResponseType.OK else None
        d.destroy()
        return yol

    def exe_sec(self):
        yol = self.dosya_sec("Windows programı seçin", ["*.exe", "*.EXE", "*.msi", "*.MSI"])
        if yol:
            calistir([BIN + "/kok-exe-calistir", yol])

    # --- Android ---
    def android(self):
        b = self.kutu()
        self.etiket(b, "Android Uyumluluğu (Waydroid)", True)
        r = subprocess.run([BIN + "/kok-android-kontrol"], capture_output=True, text=True)
        durum = "Bu bilgisayar Android'i çalıştırabilir." if r.returncode == 0 else (r.stdout.strip() or "Android şu an kullanılamıyor.")
        kurulu = os.path.exists("/var/lib/waydroid/waydroid.cfg")
        self.etiket(b, durum)
        self.etiket(b, "Android ortamı: " + ("kurulu" if kurulu else "henüz kurulmadı"))
        self.dugme(b, "Android Uygulamaları (Katalog)", lambda: calistir([BIN + "/kok-uygulamalar"]))
        self.dugme(b, "Android Ortamını Kur", lambda: calistir([BIN + "/kok-android-kurulum"]))
        self.dugme(b, "Android'i Başlat", lambda: calistir([BIN + "/kok-android-kopru"]))
        self.dugme(b, "APK Dosyası Seç ve Kur…", self.apk_sec)
        return b

    def apk_sec(self):
        yol = self.dosya_sec("APK dosyası seçin", ["*.apk", "*.APK"])
        if yol:
            calistir([BIN + "/kok-apk-kur", yol])

    # --- Donanım ---
    def donanim(self):
        b = self.kutu()
        self.etiket(b, "Ekran ve dokunmatik", True)
        for ad, yon in (("Normal", "normal"), ("Sola Döndür", "left"), ("Sağa Döndür", "right"), ("Ters Çevir", "inverted")):
            self.dugme(b, ad, lambda y=yon: calistir([BIN + "/kok-donder", y]))
        self.dugme(b, "Otomatik Döndürmeyi Aç/Kapat", lambda: calistir([BIN + "/kok-donder", "otomatik-degistir"]))
        self.dugme(b, "Ekran Klavyesi", lambda: calistir(["onboard"]))
        self.etiket(b, "Bağlantılar ve güç", True)
        self.dugme(b, "Wi-Fi ve Ağ", lambda: calistir(["nm-connection-editor"]))
        self.dugme(b, "Bluetooth", lambda: calistir(["blueman-manager"]))
        self.dugme(b, "Güç Ayarları", lambda: calistir(["xfce4-power-manager-settings"]))
        sw = Gtk.ScrolledWindow()
        sw.add(b)
        return sw

    # --- Sistem ---
    def sistem(self):
        b = self.kutu()
        self.etiket(b, "Sistem", True)
        try:
            self.etiket(b, open("/etc/kok/surum").read().strip())
        except Exception:
            self.etiket(b, "Sürüm bilgisi bulunamadı.")
        self.dugme(b, "Güncellemeleri Denetle ve Kur", lambda: calistir([BIN + "/kok-guncelle"]))
        self.dugme(b, "Kullanım Kılavuzu", lambda: calistir(["xdg-open", "/usr/share/kok/kilavuz.html"]))
        self.dugme(b, "Sağlık Kontrolü", lambda: calistir([BIN + "/kok-saglik", "--gui"]))
        self.dugme(b, "Hata Raporu Oluştur", lambda: calistir([BIN + "/kok-hata-raporu"]))
        self.dugme(b, "Kök OS'u Diske Kur", lambda: calistir(["sudo", "-E", "calamares"]))
        return b

    def guncelle(self):
        komut = "sudo apt-get update && sudo apt-get full-upgrade; echo; read -p 'Kapatmak için Enter tuşuna basın...'"
        calistir(["xfce4-terminal", "--title=Güncelleme", "-x", "bash", "-c", komut])


def GLib_escape(s):
    from gi.repository import GLib
    return GLib.markup_escape_text(s)


if __name__ == "__main__":
    pencere = Pencere()
    pencere.connect("destroy", Gtk.main_quit)
    pencere.show_all()
    Gtk.main()
