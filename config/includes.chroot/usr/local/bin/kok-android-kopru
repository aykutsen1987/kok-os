#!/bin/bash
mkdir -p "$HOME/.local/state/kok"; exec > >(tee -a "$HOME/.local/state/kok/kok-android-kopru.log") 2>&1; echo "--- $(date '+%F %T') $0 $*"
# Android'i ayrı pencerede (cage) açar; Xfce X11 üzerinde çalıştığı için gerekli.
SEBEP=$(/usr/local/bin/kok-android-kontrol) || { zenity --error --title="Kök Android" --text="$SEBEP" 2>/dev/null; exit 1; }
if [ ! -f /var/lib/waydroid/waydroid.cfg ]; then
  zenity --question --title="Kök Android" --text="Android henüz kurulmamış. Şimdi kurulsun mu?" 2>/dev/null && exec /usr/local/bin/kok-android-kurulum
  exit 0
fi
/usr/local/bin/kok-yetkili systemctl start waydroid-container.service
waydroid session start >/dev/null 2>&1 &
sleep 3
if command -v cage >/dev/null 2>&1; then
  exec cage -- waydroid show-full-ui
else
  exec waydroid show-full-ui
fi
