/* Kök OS kurulum programı: renkli, sade düğmeler ve ilerleme çubuğu */
QPushButton[objectName="view-button-next"] {
    background-color: #1976D2; color: #FFFFFF; border: none; border-radius: 6px; padding: 8px 20px; font-weight: bold;
}
QPushButton[objectName="view-button-next"]:hover { background-color: #1565C0; }
QPushButton[objectName="view-button-next"]:disabled { background-color: #3A4252; color: #8A93A3; }
QPushButton[objectName="view-button-back"] {
    background-color: #3A4252; color: #FFFFFF; border: none; border-radius: 6px; padding: 8px 18px;
}
QPushButton[objectName="view-button-back"]:disabled { background-color: #2A3142; color: #6F7888; }
QPushButton[objectName="view-button-cancel"] {
    background-color: #5A2A2A; color: #FFDADA; border: none; border-radius: 6px; padding: 8px 18px;
}
QProgressBar[objectName="exec-progress"] {
    border: none; border-radius: 10px; background-color: #2A3142; text-align: center; color: #FFFFFF; min-height: 22px;
}
QProgressBar[objectName="exec-progress"]::chunk {
    border-radius: 10px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #29B6F6, stop:1 #7E57C2);
}
