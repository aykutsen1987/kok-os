#!/bin/sh
# Linux uygulama desteği: Flatpak + Flathub (binlerce uygulama), AppImage (libfuse2)
KOK_ADIM="A15"; KOK_MOD="linuxapp"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
command -v flatpak >/dev/null 2>&1 && echo "[KOK:A15:linuxapp] flatpak kurulu" || echo "[KOK-UYARI:A15:linuxapp] flatpak kurulu degil"
mkdir -p /etc/flatpak/remotes.d
if curl -fL --retry 2 --max-time 60 -o /etc/flatpak/remotes.d/flathub.flatpakrepo https://dl.flathub.org/repo/flathub.flatpakrepo; then
  echo "[KOK:A15:linuxapp] Flathub deposu eklendi (ilk kullanimda aktif olur)"
else
  rm -f /etc/flatpak/remotes.d/flathub.flatpakrepo
  echo "[KOK-UYARI:A15:linuxapp] Flathub dosyasi indirilemedi; kullanici 'flatpak remote-add flathub' ile ekleyebilir"
fi
ls /usr/lib/x86_64-linux-gnu/libfuse.so.2* >/dev/null 2>&1 && echo "[KOK:A15:linuxapp] AppImage destegi (libfuse2) var" || echo "[KOK-UYARI:A15:linuxapp] libfuse2 yok: AppImage calismaz"
command -v winetricks >/dev/null 2>&1 && echo "[KOK:A15:linuxapp] winetricks var" || echo "[KOK-UYARI:A15:linuxapp] winetricks yok"
command -v os-prober >/dev/null 2>&1 && echo "[KOK:A15:linuxapp] os-prober var (cift acilis menusu)" || echo "[KOK-UYARI:A15:linuxapp] os-prober yok"
for p in grub-pc-bin grub-efi-amd64-bin shim-signed grub-efi-amd64-signed ntfs-3g; do dpkg -s $p >/dev/null 2>&1 && echo "[KOK:A15:linuxapp] kurulu: $p" || echo "[KOK-UYARI:A15:linuxapp] eksik: $p"; done
exit 0
