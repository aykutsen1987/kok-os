#!/bin/sh
KOK_ADIM="A8"; KOK_MOD="karsilama"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
chmod +x /usr/local/bin/kok-* 2>/dev/null || true
for f in kok-karsilama kok-saglik kok-ayarlar kok-uygulamalar; do
  if [ -x /usr/local/bin/$f ]; then echo "[KOK:A8:karsilama] hazir: $f"; else echo "[KOK-UYARI:A8:karsilama] eksik veya calistirilamaz: $f"; fi
done
for p in vlc evince galculator xfce4-taskmanager soffice; do
  command -v $p >/dev/null 2>&1 && echo "[KOK:A8:karsilama] uygulama var: $p" || echo "[KOK-UYARI:A8:karsilama] uygulama yok: $p"
done
exit 0
