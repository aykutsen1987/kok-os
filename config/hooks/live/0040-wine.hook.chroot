#!/bin/sh
KOK_ADIM="A4"; KOK_MOD="wine"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
dpkg --add-architecture i386
apt-get update
apt-get install -y wine wine64 wine32:i386 winetricks libgl1-mesa-dri:i386 || \
apt-get install -y wine winetricks || echo "[KOK-UYARI:A4:wine] Wine kurulamadi"
apt-get install -y mesa-vulkan-drivers || true
exit 0
