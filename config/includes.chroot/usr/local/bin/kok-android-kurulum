#!/bin/bash
mkdir -p "$HOME/.local/state/kok"; exec > >(tee -a "$HOME/.local/state/kok/kok-android-kurulum.log") 2>&1; echo "--- $(date '+%F %T') $0 $*"
# İlk kurulum: Android görüntüsünü indirir ve hazırlar (yaklaşık 1 GB). 3 basit adım.
SEBEP=$(/usr/local/bin/kok-android-kontrol) || { zenity --error --title="Kök Android" --text="$SEBEP" 2>/dev/null; exit 1; }
if grep -q "boot=live" /proc/cmdline; then
  zenity --question --title="Kök Android" --width=460 --text="ADIM 1/3 – Başlayalım\n\nŞu an canlı oturumdasınız: Android bu oturumda çalışır ama bilgisayarı kapatınca silinir. Kalıcı olması için önce Kök OS'u bilgisayara kurun.\n\nİnternetten yaklaşık 1 GB indirilecek. Devam edilsin mi?" 2>/dev/null || exit 0
else
  zenity --question --title="Kök Android" --width=460 --text="ADIM 1/3 – Başlayalım\n\nAndroid ortamı kurulacak. İnternetten yaklaşık 1 GB indirilecek (10-20 dakika sürebilir). Devam edilsin mi?" 2>/dev/null || exit 0
fi
TUR=$(zenity --list --radiolist --title="Kök Android" --text="ADIM 2/3 – Android türünü seçin (emin değilseniz ilkini bırakın):" --column="" --column="Seçenek" --column="Kod" --hide-column=3 --print-column=3 TRUE "Standart (Google'sız, önerilir)" VANILLA FALSE "Google Play'li (ek cihaz kaydı gerekir)" GAPPS 2>/dev/null) || exit 0
[ -z "$TUR" ] && TUR=VANILLA
echo "Android türü: $TUR"
/usr/local/bin/kok-yetkili bash -c "waydroid init -s $TUR -f && systemctl enable --now waydroid-container.service" \
 | zenity --progress --pulsate --auto-close --no-cancel --title="Kök Android" --text="ADIM 3/3 – Android hazırlanıyor. Lütfen bekleyin, pencereyi kapatmayın…" 2>/dev/null
if [ -d /var/lib/waydroid/images ] || [ -f /var/lib/waydroid/waydroid.cfg ]; then
  /usr/local/bin/kok-android-onyukle
  zenity --info --title="Kök Android" --width=420 --text="Kurulum tamamlandı.\n\nNe yapabilirsiniz?\n• Menüden 'Android' uygulamasını açın\n• 'Kök Uygulamalar' ile listeden uygulama seçin\n• .apk dosyasına çift tıklayarak kurun" 2>/dev/null
else
  zenity --error --title="Kök Android" --text="Kurulum tamamlanamadı. İnternet bağlantınızı kontrol edip tekrar deneyin." 2>/dev/null
fi
