#!/bin/bash
# Kök Profil: RAM'e göre hafif/standart profil seçer; kompozitör (yuvarlak köşeler) ve rıhtımı ayarlar.
RAM_MB=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)
if [ "$RAM_MB" -le 2200 ]; then PROFIL=hafif; else PROFIL=standart; fi
TERCIH=$(cat "$HOME/.config/kok/profil" 2>/dev/null)
case "$TERCIH" in hafif|standart) PROFIL="$TERCIH";; esac
mkdir -p /tmp/kok "$HOME/.local/state/kok"
echo "$PROFIL" > /tmp/kok/profil
YUVARLAK=1; [ -f "$HOME/.config/kok/yuvarlak-kapali" ] && YUVARLAK=0
if [ "$PROFIL" = "hafif" ]; then
  command -v dconf >/dev/null && dconf write /net/launchpad/plank/docks/dock1/icon-size 40 2>/dev/null
  pkill -x picom 2>/dev/null
  xfconf-query -c xfwm4 -p /general/use_compositing -s false 2>/dev/null
  echo "Kök Profil: Hafif mod etkin (${RAM_MB} MB RAM). Animasyonlar ve yuvarlak köşeler kapalı."
else
  command -v dconf >/dev/null && dconf write /net/launchpad/plank/docks/dock1/icon-size 48 2>/dev/null
  if [ "$YUVARLAK" = 1 ] && command -v picom >/dev/null 2>&1; then
    xfconf-query -c xfwm4 -p /general/use_compositing -s false 2>/dev/null
    pgrep -x picom >/dev/null || picom --config /usr/share/kok/picom.conf -b --log-file "$HOME/.local/state/kok/picom.log"
    echo "Kök Profil: Standart mod etkin (${RAM_MB} MB RAM). Yuvarlak köşeler açık (picom)."
  else
    pkill -x picom 2>/dev/null
    xfconf-query -c xfwm4 -p /general/use_compositing -s true 2>/dev/null
    echo "Kök Profil: Standart mod etkin (${RAM_MB} MB RAM). Yerleşik kompozitör."
  fi
fi
