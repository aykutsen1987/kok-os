#!/bin/sh
KOK_ADIM="A6"; KOK_MOD="skel"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
# Kullanıcı ayarları GitHub'a nokta'lı klasörle yüklenemediği için /usr/share/kok/skel-config içinde saklanır
if [ -d /usr/share/kok/skel-config ]; then
  mkdir -p /etc/skel/.config
  cp -a /usr/share/kok/skel-config/. /etc/skel/.config/
  echo "[KOK:A6:skel] kopyalandi:"; find /etc/skel/.config -type f
else
  echo "[KOK-UYARI:A6:skel] /usr/share/kok/skel-config yok (rıhtım ve menü ayarları uygulanmaz)"
fi
exit 0
