#!/bin/bash
# Raporu hazırlar, panoya kopyalar ve GitHub "yeni sorun" sayfasını açar.
mkdir -p "$HOME/.local/state/kok"; exec > >(tee -a "$HOME/.local/state/kok/kok-geri-bildirim.log") 2>&1; echo "--- $(date '+%F %T') $0"
DEPO=$(grep '^GITHUB_DEPO=' /etc/kok/geri-bildirim.conf 2>/dev/null | cut -d= -f2)
RAPOR=$(KOK_SESSIZ=1 /usr/local/bin/kok-hata-raporu | tail -1)
if [ -z "$DEPO" ]; then
  zenity --info --title="Kök OS" --width=420 --text="GitHub deposu ayarlı değil. /etc/kok/geri-bildirim.conf içine GITHUB_DEPO=kullanici/depo yazın.\n\nRapor hazır: $RAPOR (panoya kopyalandı)." 2>/dev/null
  exit 0
fi
OZET=$(sed -n '/ADIM TABLOSU/,/ÖZET:/p' "$RAPOR" | head -30)
q(){ python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))' "$1"; }
URL="https://github.com/$DEPO/issues/new?title=$(q "Kök OS hata raporu $(date +%F)")&body=$(q "Tam rapor panoda: bu kutuya Ctrl+V ile yapıştırın.

$OZET")"
zenity --info --title="Kök OS" --width=420 --text="Rapor panoya kopyalandı. Açılan GitHub sayfasında metin kutusuna Ctrl+V ile yapıştırıp gönderin." 2>/dev/null
xdg-open "$URL"
