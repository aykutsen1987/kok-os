#!/bin/bash
# root olarak çalışır: kok-dil-uygula tr|en [klavye]
export PATH=$PATH:/usr/sbin:/sbin
case "$1" in tr) L=tr_TR.UTF-8; K=tr;; en) L=en_US.UTF-8; K=us;; *) exit 1;; esac
sed -i "s/^# *$L UTF-8/$L UTF-8/" /etc/locale.gen
grep -q "^$L UTF-8" /etc/locale.gen || echo "$L UTF-8" >> /etc/locale.gen
locale-gen
update-locale LANG=$L LANGUAGE
if [ "$2" = "klavye" ]; then
  sed -i "s/^XKBLAYOUT=.*/XKBLAYOUT=\"$K\"/" /etc/default/keyboard
  localectl set-x11-keymap "$K" 2>/dev/null || true
fi
echo "[KOK] dil=$L klavye=${2:-degismedi}"
