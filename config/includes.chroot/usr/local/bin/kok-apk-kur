#!/bin/bash
mkdir -p "$HOME/.local/state/kok"; exec > >(tee -a "$HOME/.local/state/kok/kok-apk-kur.log") 2>&1; echo "--- $(date '+%F %T') $0 $*"
# .apk dosyasını Android ortamına kurar.
APK="$1"
[ -f "$APK" ] || { zenity --error --title="Kök Android" --text="APK dosyası bulunamadı." 2>/dev/null; exit 1; }
SEBEP=$(/usr/local/bin/kok-android-kontrol) || { zenity --error --title="Kök Android" --text="$SEBEP" 2>/dev/null; exit 1; }
if [ ! -f /var/lib/waydroid/waydroid.cfg ]; then
  zenity --question --title="Kök Android" --text="Android ortamı henüz kurulmamış. Önce kurulsun mu?" 2>/dev/null && /usr/local/bin/kok-android-kurulum
  [ -f /var/lib/waydroid/waydroid.cfg ] || exit 1
fi
pkexec systemctl start waydroid-container.service
waydroid session start >/dev/null 2>&1 &
sleep 4
if waydroid app install "$APK"; then
  notify-send "Kök Android" "$(basename "$APK") kuruldu. Uygulama menüsünde bulabilirsiniz." 2>/dev/null
else
  zenity --error --title="Kök Android" --text="Uygulama kurulamadı.\nDosya bu bilgisayarın işlemcisiyle uyumsuz olabilir (yalnızca ARM için derlenmiş olabilir)." 2>/dev/null
fi
