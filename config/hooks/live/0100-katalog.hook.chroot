#!/bin/sh
KOK_ADIM="A7"; KOK_MOD="katalog"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
if python3 -m json.tool /usr/share/kok/android-katalog.json >/dev/null 2>&1; then
  echo "[KOK:A7:katalog] gomulu katalog gecerli"
else
  echo "[KOK-UYARI:A7:katalog] gomulu katalog JSON gecersiz"
fi
echo "Onyuklu APK'lar:"; ls -la /usr/share/kok/apk
python3 -m py_compile /usr/local/bin/kok-uygulamalar /usr/local/bin/kok-ayarlar 2>/dev/null && echo "[KOK:A7:katalog] python araclari derlendi" || echo "[KOK-UYARI:A7:katalog] python araclari derlenemedi"
exit 0
