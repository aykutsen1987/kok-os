#!/usr/bin/env python3
# Kök Ayarlar Merkezi – Türkçe / English sistem ayarları
import gi, os, sys, subprocess
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib
sys.path.insert(0, "/usr/local/lib/kok")
from kok_i18n import T, agac, dil, kilavuz

LOGDIR = os.path.expanduser("~/.local/state/kok")
os.makedirs(LOGDIR, exist_ok=True)
try:
    sys.stderr = open(os.path.join(LOGDIR, "kok-ayarlar.log"), "a", buffering=1)
except Exception:
    pass
BIN = "/usr/local/bin"
PROFIL_DOSYASI = os.path.expanduser("~/.config/kok/profil")
YUVARLAK_BAYRAK = os.path.expanduser("~/.config/kok/yuvarlak-kapali")
KOSE_DOSYASI = os.path.expanduser("~/.config/kok/kose-yaricap")
PICOM_GUNLUK = os.path.expanduser("~/.local/state/kok/picom.log")
SEKMELER = ["genel", "gorunum", "windows", "android", "donanim", "dil", "sistem"]


def mesaj(baslik, metin, parent=None):
    d = Gtk.MessageDialog(parent=parent, modal=True, message_type=Gtk.MessageType.INFO,
                          buttons=Gtk.ButtonsType.OK, text=T(baslik))
    d.format_secondary_text(T(metin))
    d.set_position(Gtk.WindowPosition.CENTER)
    d.run()
    d.destroy()


def calistir(args):
    try:
        subprocess.Popen(args)
    except Exception as e:
        print("HATA:", args, e, file=sys.stderr)
        mesaj("Çalıştırılamadı", "%s\n\n%s" % (" ".join(args), e))


def cikti(args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=20).stdout.strip()
    except Exception as e:
        print("HATA:", args, e, file=sys.stderr)
        return ""


def tema_var(ad):
    return os.path.isdir("/usr/share/themes/" + ad)


class Pencere(Gtk.Window):
    def __init__(self, sekme=None):
        super().__init__(title="Kök Ayarlar")
        self.set_default_size(540, 480)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("preferences-system")
        self.nb = Gtk.Notebook()
        self.add(self.nb)
        for ad, fn in (("Genel", self.genel), ("Görünüm", self.gorunum), ("Windows", self.windows),
                       ("Android", self.android), ("Donanım", self.donanim), ("Dil", self.dil_sekmesi),
                       ("Sistem", self.sistem)):
            self.nb.append_page(fn(), Gtk.Label(label=ad))
        agac(self)
        if sekme in SEKMELER:
            GLib.idle_add(self.nb.set_current_page, SEKMELER.index(sekme))

    def kutu(self):
        b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        b.set_border_width(16)
        return b

    def etiket(self, kutu, metin, kalin=False):
        e = Gtk.Label(xalign=0)
        e.set_line_wrap(True)
        e.set_selectable(True)
        if kalin:
            e.set_markup("<b>%s</b>" % GLib.markup_escape_text(metin))
        else:
            e.set_text(metin)
        kutu.pack_start(e, False, False, 0)
        return e

    def dugme(self, kutu, metin, fn):
        d = Gtk.Button(label=metin)
        d.connect("clicked", lambda _b: fn())
        kutu.pack_start(d, False, False, 0)
        return d

    def kaydirmali(self, b):
        sw = Gtk.ScrolledWindow()
        sw.add(b)
        return sw

    # --- Genel ---
    def genel(self):
        b = self.kutu()
        ram = cikti(["awk", "/MemTotal/{print int($2/1024)}", "/proc/meminfo"])
        cpu = cikti(["bash", "-c", "grep -m1 'model name' /proc/cpuinfo | cut -d: -f2"])
        try:
            mevcut = open("/tmp/kok/profil").read().strip()
        except Exception:
            mevcut = ""
        self.etiket(b, "Bu bilgisayar", True)
        self.etiket(b, "İşlemci:%s\nBellek: %s MB\nAktif profil: %s" % (cpu, ram, mevcut or "bilinmiyor"))
        self.etiket(b, "Performans profili", True)
        self.etiket(b, "Hafif profil animasyonları kapatır, eski bilgisayarlarda daha akıcı çalışır.")
        self.combo = Gtk.ComboBoxText()
        for ad in ("Otomatik (önerilen)", "Hafif", "Standart"):
            self.combo.append_text(T(ad))
        sec = 0
        try:
            sec = {"hafif": 1, "standart": 2}.get(open(PROFIL_DOSYASI).read().strip(), 0)
        except Exception:
            pass
        self.combo.set_active(sec)
        b.pack_start(self.combo, False, False, 0)
        self.dugme(b, "Profili Uygula", self.profil_uygula)
        self.dugme(b, "Performans Özeti", lambda: calistir([BIN + "/kok-performans", "--gui"]))
        return self.kaydirmali(b)

    def profil_uygula(self):
        deger = ["otomatik", "hafif", "standart"][self.combo.get_active()]
        os.makedirs(os.path.dirname(PROFIL_DOSYASI), exist_ok=True)
        if deger == "otomatik":
            try:
                os.remove(PROFIL_DOSYASI)
            except FileNotFoundError:
                pass
        else:
            open(PROFIL_DOSYASI, "w").write(deger + "\n")
        calistir([BIN + "/kok-profil"])
        mesaj("Kaydedildi", "Profil ayarı uygulandı.", self)

    # --- Görünüm ---
    def gorunum(self):
        b = self.kutu()
        self.etiket(b, "Tema", True)
        self.dugme(b, "Koyu Tema", lambda: self.tema_ayarla(True))
        self.dugme(b, "Açık Tema", lambda: self.tema_ayarla(False))
        self.etiket(b, "Pencere köşeleri", True)
        self.etiket(b, "Yuvarlak köşeler eski bilgisayarlarda biraz daha fazla işlemci kullanır. Hafif profilde kapalıdır.")
        self.dugme(b, "Yuvarlak Köşeleri Aç", lambda: self.yuvarlak(True))
        self.dugme(b, "Yuvarlak Köşeleri Kapat", lambda: self.yuvarlak(False))
        self.etiket(b, "Köşe yuvarlaklığı (0 = köşeler köşeli, 24 = en yuvarlak)", True)
        try:
            mevcut = int(open(KOSE_DOSYASI).read().strip())
        except Exception:
            mevcut = 14
        kay = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 24, 1)
        kay.set_value(mevcut)
        kay.set_digits(0)
        kay.set_hexpand(True)
        b.pack_start(kay, False, False, 4)
        self.dugme(b, "Yuvarlaklığı Uygula", lambda: self.kose_yaricap(int(kay.get_value())))
        self.durum = self.etiket(b, "")
        self.dugme(b, "Köşe Günlüğünü Göster (sorun giderme)", lambda: calistir(["mousepad", PICOM_GUNLUK]))
        self.etiket(b, "Duvar kâğıdı ve diğer görünüm ayarları için: Uygulamalar menüsü → Ayarlar → Masaüstü.")
        self.dugme(b, "Masaüstü Ayarlarını Aç", lambda: calistir(["xfdesktop-settings"]))
        self.dugme(b, "Rıhtım Ayarlarını Aç", lambda: calistir(["plank", "--preferences"]))
        return self.kaydirmali(b)

    def tema_ayarla(self, koyu):
        if koyu:
            ad = "WhiteSur-Dark" if tema_var("WhiteSur-Dark") else "Arc-Dark"
        else:
            ad = "WhiteSur-Light" if tema_var("WhiteSur-Light") else "Arc"
        cikti(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-n", "-t", "string", "-s", ad])
        cikti(["xfconf-query", "-c", "xfwm4", "-p", "/general/theme", "-n", "-t", "string", "-s", ad])
        mesaj("Tema değişti", "Uygulanan tema: " + ad, self)

    def kose_yaricap(self, deger):
        os.makedirs(os.path.dirname(KOSE_DOSYASI), exist_ok=True)
        open(KOSE_DOSYASI, "w").write("%d\n" % deger)
        if deger == 0:
            open(YUVARLAK_BAYRAK, "w").write("1\n")
        else:
            try:
                os.remove(YUVARLAK_BAYRAK)
            except FileNotFoundError:
                pass
        calistir(["pkill", "-x", "picom"])
        import time
        time.sleep(0.6)
        calistir([BIN + "/kok-profil"])
        GLib.timeout_add_seconds(6, self._kose_durum)
        self.durum.set_text("Uygulanıyor… birkaç saniye bekleyin.")

    def _kose_durum(self):
        calisiyor = subprocess.run(["pgrep", "-x", "picom"], capture_output=True).returncode == 0
        self.durum.set_text("Köşe yuvarlama çalışıyor." if calisiyor else
                            "Köşe yuvarlama çalışmıyor (sıfır seçildiyse bu normaldir). Ayrıntı için günlüğü açın.")
        return False

    def yuvarlak(self, ac):
        os.makedirs(os.path.dirname(YUVARLAK_BAYRAK), exist_ok=True)
        if ac:
            try:
                os.remove(YUVARLAK_BAYRAK)
            except FileNotFoundError:
                pass
        else:
            open(YUVARLAK_BAYRAK, "w").write("1\n")
        calistir([BIN + "/kok-profil"])
        mesaj("Kaydedildi", "Görünüm ayarı uygulandı.", self)

    # --- Windows ---
    def windows(self):
        b = self.kutu()
        surum = cikti(["wine", "--version"]) or T("Kurulu değil")
        self.etiket(b, "Windows Uyumluluğu (Wine)", True)
        self.etiket(b, "Sürüm: " + surum)
        self.etiket(b, "Bir .exe dosyasına çift tıklamak yeterlidir. Her program kendi ayrı ortamında çalışır.")
        self.dugme(b, "Bir Windows Programı Seç ve Çalıştır…", self.exe_sec)
        self.dugme(b, "Wine Ayarlarını Aç", lambda: calistir(["winecfg"]))
        self.dugme(b, "Program Ortamları Klasörünü Aç", self.prefix_ac)
        self.dugme(b, "Uyumluluk Notlarını Oku", lambda: calistir(["mousepad", "/usr/share/kok/uyumluluk.md"]))
        return self.kaydirmali(b)

    def prefix_ac(self):
        yol = os.path.expanduser("~/.local/share/kok-wine")
        os.makedirs(yol, exist_ok=True)
        calistir(["xdg-open", yol])

    def dosya_sec(self, baslik, desenler):
        d = Gtk.FileChooserDialog(title=T(baslik), parent=self, action=Gtk.FileChooserAction.OPEN)
        d.add_buttons(T("İptal"), Gtk.ResponseType.CANCEL, T("Seç"), Gtk.ResponseType.OK)
        f = Gtk.FileFilter()
        f.set_name(T("Uygun dosyalar"))
        for p in desenler:
            f.add_pattern(p)
        d.add_filter(f)
        yol = d.get_filename() if d.run() == Gtk.ResponseType.OK else None
        d.destroy()
        return yol

    def exe_sec(self):
        yol = self.dosya_sec("Windows programı seçin", ["*.exe", "*.EXE", "*.msi", "*.MSI"])
        if yol:
            calistir([BIN + "/kok-exe-calistir", yol])

    # --- Android ---
    def android(self):
        b = self.kutu()
        self.etiket(b, "Android Uyumluluğu (Waydroid)", True)
        r = subprocess.run([BIN + "/kok-android-kontrol"], capture_output=True, text=True)
        durum = "Bu bilgisayar Android'i çalıştırabilir." if r.returncode == 0 else (T(r.stdout.strip()) or "Android şu an kullanılamıyor.")
        kurulu = os.path.exists("/var/lib/waydroid/waydroid.cfg")
        self.etiket(b, durum)
        self.etiket(b, "Android ortamı: " + ("kurulu" if kurulu else "henüz kurulmadı"))
        self.dugme(b, "Android Uygulamaları (Katalog)", lambda: calistir([BIN + "/kok-uygulamalar"]))
        self.dugme(b, "Android Ortamını Kur", lambda: calistir([BIN + "/kok-android-kurulum"]))
        self.dugme(b, "Android'i Başlat", lambda: calistir([BIN + "/kok-android-kopru"]))
        self.dugme(b, "APK Dosyası Seç ve Kur…", self.apk_sec)
        return self.kaydirmali(b)

    def apk_sec(self):
        yol = self.dosya_sec("APK dosyası seçin", ["*.apk", "*.APK"])
        if yol:
            calistir([BIN + "/kok-apk-kur", yol])

    # --- Donanım ---
    def donanim(self):
        b = self.kutu()
        self.etiket(b, "Ekran ve dokunmatik", True)
        for ad, yon in (("Normal", "normal"), ("Sola Döndür", "left"), ("Sağa Döndür", "right"), ("Ters Çevir", "inverted")):
            self.dugme(b, ad, lambda y=yon: calistir([BIN + "/kok-donder", y]))
        self.dugme(b, "Otomatik Döndürmeyi Aç/Kapat", lambda: calistir([BIN + "/kok-donder", "otomatik-degistir"]))
        self.dugme(b, "Ekran Klavyesi", lambda: calistir(["onboard"]))
        self.etiket(b, "Bağlantılar ve güç", True)
        self.dugme(b, "Wi-Fi ve Ağ", lambda: calistir(["nm-connection-editor"]))
        self.dugme(b, "Bluetooth", lambda: calistir(["blueman-manager"]))
        self.dugme(b, "Güç Ayarları", lambda: calistir(["xfce4-power-manager-settings"]))
        return self.kaydirmali(b)

    # --- Dil / Language ---
    def dil_sekmesi(self):
        b = self.kutu()
        self.etiket(b, "Sistem dili", True)
        self.etiket(b, "Şu anki dil: " + ("English" if dil() == "en" else "Türkçe"))
        self.rb_tr = Gtk.RadioButton.new_with_label_from_widget(None, "Türkçe")
        self.rb_en = Gtk.RadioButton.new_with_label_from_widget(self.rb_tr, "English")
        (self.rb_en if dil() == "en" else self.rb_tr).set_active(True)
        b.pack_start(self.rb_tr, False, False, 0)
        b.pack_start(self.rb_en, False, False, 0)
        self.cb_klavye = Gtk.CheckButton(label="Klavye düzenini de değiştir (Türkçe Q ↔ US İngilizce)")
        b.pack_start(self.cb_klavye, False, False, 0)
        self.dugme(b, "Uygula", self.dil_uygula)
        return self.kaydirmali(b)

    def dil_uygula(self):
        args = [BIN + "/kok-dil", "en" if self.rb_en.get_active() else "tr"]
        if self.cb_klavye.get_active():
            args.append("klavye")
        calistir(args)

    # --- Sistem ---
    def sistem(self):
        b = self.kutu()
        self.etiket(b, "Sistem", True)
        try:
            self.etiket(b, open("/etc/kok/surum").read().strip())
        except Exception:
            self.etiket(b, "Sürüm bilgisi bulunamadı.")
        self.dugme(b, "Kök OS Hakkında", lambda: calistir([BIN + "/kok-hakkinda"]))
        self.dugme(b, "Güncellemeleri Denetle ve Kur", lambda: calistir([BIN + "/kok-guncelle"]))
        self.dugme(b, "Kullanım Kılavuzu", lambda: calistir(["xdg-open", kilavuz()]))
        self.dugme(b, "Sağlık Kontrolü", lambda: calistir([BIN + "/kok-saglik", "--gui"]))
        self.dugme(b, "Hata Raporu Oluştur", lambda: calistir([BIN + "/kok-hata-raporu"]))
        self.dugme(b, "Hata Raporunu GitHub'a Gönder", lambda: calistir([BIN + "/kok-geri-bildirim"]))
        self.etiket(b, "Açılış hızı", True)
        self.etiket(b, "AppArmor (güvenlik profilleri) eski bilgisayarlarda açılışı 50 saniyeye kadar uzatabilir. Kapatırsanız sistem daha hızlı açılır; yalnızca birkaç arka plan servisinin ek koruması devre dışı kalır.")
        self.aa_durum = self.etiket(b, self.aa_metin())
        self.dugme(b, "AppArmor'u Kapat (açılışı hızlandırır)", lambda: self.aa_ayar(False))
        self.dugme(b, "AppArmor'u Aç (varsayılan)", lambda: self.aa_ayar(True))
        self.dugme(b, "Kök OS'u Diske Kur", lambda: calistir([BIN + "/kok-kur"]))
        return self.kaydirmali(b)

    def aa_metin(self):
        sonuc = subprocess.run(["systemctl", "is-enabled", "apparmor.service"], capture_output=True, text=True)
        return "AppArmor şu an: " + ("AÇIK" if sonuc.stdout.strip() == "enabled" else "KAPALI")

    def aa_ayar(self, ac):
        subprocess.run([BIN + "/kok-yetkili", "systemctl", "enable" if ac else "disable", "apparmor.service"],
                       capture_output=True)
        self.aa_durum.set_text(self.aa_metin() + " (bilgisayarı yeniden başlatınca geçerli olur)")


if __name__ == "__main__":
    sekme = None
    if "--sekme" in sys.argv:
        try:
            sekme = sys.argv[sys.argv.index("--sekme") + 1]
        except IndexError:
            pass
    p = Pencere(sekme)
    p.connect("destroy", Gtk.main_quit)
    p.show_all()
    Gtk.main()
