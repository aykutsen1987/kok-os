#!/bin/bash
# Kök Performans Özeti: eski cihazlarda gerçek ölçüm toplar.
export PATH=$PATH:/usr/sbin:/sbin
mkdir -p /tmp/kok; OUT=/tmp/kok/performans.txt
{
echo "== Kök Performans Özeti == $(date '+%F %T')"
echo "Profil        : $(cat /tmp/kok/profil 2>/dev/null || echo ?)"
echo "İşlemci       : $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2)  ($(nproc) çekirdek)"
free -m | awk 'NR==2{printf "Bellek        : toplam %d MB, kullanılan %d MB, boş+önbellek %d MB\n",$2,$3,$7}'
echo "ZRAM          : $(grep zram /proc/swaps | awk '{print $1, $3" KB"}' || true)"
echo "Swappiness    : $(cat /proc/sys/vm/swappiness)"
echo "CPU yönetimi  : $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo bilinmiyor)"
echo "Açılış süresi : $(systemd-analyze 2>/dev/null | head -1 | cut -c1-120)"
echo "Disk zamanlayıcıları:"
for d in /sys/block/*/queue/scheduler; do [ -f "$d" ] && echo "  $(echo $d | cut -d/ -f4): $(cat $d)"; done
echo "En çok bellek kullanan süreçler:"
ps -eo comm,rss --sort=-rss | head -9 | awk 'NR==1{next}{printf "  %-22s %6d MB\n",$1,$2/1024}'
echo "Yavaş açılan servisler:"
systemd-analyze blame 2>/dev/null | head -5 | sed 's/^/  /'
} 2>&1 | tee "$OUT"
if [ "$1" = "--gui" ] && command -v zenity >/dev/null; then
  zenity --text-info --title="Kök Performans Özeti" --width=640 --height=520 --filename="$OUT" 2>/dev/null
fi
