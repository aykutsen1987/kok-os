#!/usr/bin/env python3
# Kök OS: renkli, sade onay penceresi (kurulum uyarıları için).
# Çıkış kodu: 0 = onaylandı, 1 = vazgeçildi/kapatıldı, 5 = süre doldu
import argparse
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk  # noqa: E402

TEMA = {
    "green":  ("#2E7D32", "#1B5E20", "✔"),
    "red":    ("#C62828", "#8E0000", "⚠"),
    "orange": ("#EF6C00", "#B53D00", "⚠"),
    "blue":   ("#1565C0", "#0D47A1", "i"),
}

a = argparse.ArgumentParser()
a.add_argument("--tur", default="blue", choices=list(TEMA))
a.add_argument("--baslik", required=True)
a.add_argument("--metin", required=True)
a.add_argument("--evet", default="Tamam")
a.add_argument("--hayir", default="")
a.add_argument("--yaz", default="", help="onay için yazılması gereken kelime")
a.add_argument("--sure", type=int, default=0)
arg = a.parse_args()

renk, koyu, simge = TEMA[arg.tur]
css = """
window { background: #ffffff; }
.ust { background: %(renk)s; padding: 20px; }
.simge { background: rgba(255,255,255,0.22); border-radius: 30px; color: #ffffff; font-size: 30px; font-weight: bold; }
.baslik { color: #ffffff; font-size: 17px; font-weight: bold; }
.metin { color: #1b2430; font-size: 12px; }
.ipucu { color: #5b6675; font-size: 11px; }
entry { font-size: 15px; padding: 8px; min-height: 22px; }
button.vazgec { background: #eceff3; background-image: none; color: #1b2430; border: 1px solid #cfd6dd; padding: 9px 22px; border-radius: 6px; font-weight: bold; }
button.onay { background: %(renk)s; background-image: none; color: #ffffff; border: none; padding: 9px 22px; border-radius: 6px; font-weight: bold; }
button.onay:hover { background: %(koyu)s; background-image: none; }
button.onay:disabled { background: #c9ced6; background-image: none; color: #f4f6f8; }
""" % {"renk": renk, "koyu": koyu}
sag = Gtk.CssProvider()
sag.load_from_data(css.encode("utf-8"))
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), sag, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

pen = Gtk.Window(title="Kök OS")
pen.set_default_size(580, -1)
pen.set_resizable(False)
pen.set_position(Gtk.WindowPosition.CENTER)
pen.set_keep_above(True)
pen.set_type_hint(Gdk.WindowTypeHint.DIALOG)
pen.set_skip_taskbar_hint(False)
sonuc = {"kod": 1}


def bitir(kod):
    sonuc["kod"] = kod
    Gtk.main_quit()


pen.connect("delete-event", lambda *_: (bitir(1), True)[1])

kok = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
pen.add(kok)

ust = Gtk.Box(spacing=16)
ust.get_style_context().add_class("ust")
ik = Gtk.Label(label=simge)
ik.set_size_request(60, 60)
ik.get_style_context().add_class("simge")
ust.pack_start(ik, False, False, 0)
bs = Gtk.Label(label=arg.baslik)
bs.set_xalign(0)
bs.set_line_wrap(True)
bs.set_max_width_chars(34)
bs.get_style_context().add_class("baslik")
ust.pack_start(bs, True, True, 0)
kok.pack_start(ust, False, False, 0)

govde = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
govde.set_border_width(22)
mt = Gtk.Label()
mt.set_markup(arg.metin)
mt.set_xalign(0)
mt.set_line_wrap(True)
mt.set_max_width_chars(58)
mt.get_style_context().add_class("metin")
govde.pack_start(mt, False, False, 0)

giris = None
if arg.yaz:
    ip = Gtk.Label()
    ip.set_markup("Onaylamak için büyük harflerle <b>%s</b> yazın:" % GLib.markup_escape_text(arg.yaz))
    ip.set_xalign(0)
    ip.get_style_context().add_class("ipucu")
    govde.pack_start(ip, False, False, 0)
    giris = Gtk.Entry()
    giris.set_max_length(20)
    govde.pack_start(giris, False, False, 0)
kok.pack_start(govde, True, True, 0)

dugmeler = Gtk.Box(spacing=10)
dugmeler.set_border_width(18)
dugmeler.set_halign(Gtk.Align.END)
if arg.hayir:
    hay = Gtk.Button(label=arg.hayir)
    hay.get_style_context().add_class("vazgec")
    hay.connect("clicked", lambda *_: bitir(1))
    dugmeler.pack_start(hay, False, False, 0)
evt = Gtk.Button(label=arg.evet)
evt.get_style_context().add_class("onay")
evt.connect("clicked", lambda *_: bitir(0))
dugmeler.pack_start(evt, False, False, 0)
kok.pack_end(dugmeler, False, False, 0)


def temiz(t):
    return t.strip().upper().replace("İ", "I").replace("ı", "I")


if giris is not None:
    evt.set_sensitive(False)
    giris.connect("changed", lambda e: evt.set_sensitive(temiz(e.get_text()) == temiz(arg.yaz)))
    giris.connect("activate", lambda e: evt.clicked() if evt.get_sensitive() else None)
    giris.grab_focus()
elif arg.hayir:
    hay.grab_focus()   # tehlikeli işlemde varsayılan odak "Vazgeç"te
else:
    evt.grab_focus()

if arg.sure:
    GLib.timeout_add_seconds(arg.sure, lambda: (bitir(0 if not arg.hayir else 5), False)[1])

pen.show_all()
pen.present()
Gtk.main()
sys.exit(sonuc["kod"])
