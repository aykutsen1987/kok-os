#!/bin/sh
KOK_ADIM="A3"; KOK_MOD="tema"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
X=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml
cd /tmp
if git clone --depth 1 https://github.com/vinceliuice/WhiteSur-gtk-theme.git; then
  mkdir -p /usr/share/kok
  (cd WhiteSur-gtk-theme && ./install.sh -d /usr/share/themes 2>&1 | tee /usr/share/kok/whitesur-gtk.log | tail -25)
else
  echo "[KOK-UYARI:A3:tema] WhiteSur GTK deposu indirilemedi"
fi
[ -d /usr/share/themes/WhiteSur-Dark ] || echo "[KOK-UYARI:A3:tema] WhiteSur GTK kurulamadi, Arc kullanilacak"
if git clone --depth 1 https://github.com/vinceliuice/WhiteSur-icon-theme.git; then
  (cd WhiteSur-icon-theme && ./install.sh -d /usr/share/icons 2>&1 | tee /usr/share/kok/whitesur-icon.log | tail -10)
else
  echo "[KOK-UYARI:A3:tema] WhiteSur simge deposu indirilemedi"
fi
[ -d /usr/share/icons/WhiteSur-dark ] || echo "[KOK-UYARI:A3:tema] WhiteSur simge kurulamadi, Papirus kullanilacak"
if [ -d /usr/share/themes/WhiteSur-Dark ]; then
  sed -i 's/Arc-Dark/WhiteSur-Dark/g' $X/xsettings.xml $X/xfwm4.xml
  echo "[KOK:A3:tema] WhiteSur GTK etkin"
fi
if [ -d /usr/share/icons/WhiteSur-dark ]; then
  sed -i 's/Papirus-Dark/WhiteSur-dark/' $X/xsettings.xml
fi
rm -rf /tmp/WhiteSur-*
exit 0
