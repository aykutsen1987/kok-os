#!/bin/bash
# Kullanım: kok-donder normal|left|right|inverted | otomatik-degistir | --izle
export PATH=$PATH:/usr/sbin:/sbin
mkdir -p "$HOME/.local/state/kok" "$HOME/.config/kok"
exec 2>>"$HOME/.local/state/kok/kok-donder.log"
FLAG="$HOME/.config/kok/otomatik-dondur-kapali"
OUT=$(xrandr 2>/dev/null | awk '/ connected primary/{print $1; exit}')
[ -z "$OUT" ] && OUT=$(xrandr 2>/dev/null | awk '/ connected/{print $1; exit}')

uygula() {
  local M
  case "$1" in
    normal)   M="1 0 0 0 1 0 0 0 1";;
    left)     M="0 -1 1 1 0 0 0 0 1";;
    right)    M="0 1 0 -1 0 1 0 0 1";;
    inverted) M="-1 0 1 0 -1 1 0 0 1";;
    *) return 1;;
  esac
  xrandr --output "$OUT" --rotate "$1" || return 1
  for id in $(xinput list 2>/dev/null | grep -iE 'touch|wacom|pen|finger|stylus' | grep -o 'id=[0-9]*' | cut -d= -f2); do
    xinput set-prop "$id" "Coordinate Transformation Matrix" $M 2>/dev/null
  done
}

case "$1" in
  normal|left|right|inverted) uygula "$1";;
  otomatik-degistir)
    if [ -f "$FLAG" ]; then rm -f "$FLAG"; notify-send "Kök OS" "Otomatik ekran döndürme açıldı." 2>/dev/null
    else touch "$FLAG"; notify-send "Kök OS" "Otomatik ekran döndürme kapatıldı." 2>/dev/null; fi;;
  --izle)
    ls /sys/bus/iio/devices/iio:device*/in_accel_x_raw >/dev/null 2>&1 || exit 0
    command -v monitor-sensor >/dev/null 2>&1 || exit 0
    monitor-sensor --accel 2>/dev/null | while read -r satir; do
      [ -f "$FLAG" ] && continue
      case "$satir" in
        *"orientation changed: normal"*)    uygula normal;;
        *"orientation changed: left-up"*)   uygula left;;
        *"orientation changed: right-up"*)  uygula right;;
        *"orientation changed: bottom-up"*) uygula inverted;;
      esac
    done;;
  *) echo "Kullanım: kok-donder normal|left|right|inverted|otomatik-degistir";;
esac
