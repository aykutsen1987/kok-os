#!/bin/sh
KOK_ADIM="A12"; KOK_MOD="son"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
ldconfig && echo "[KOK:A12:son] ld.so.cache guncel"
[ -d /etc/skel/.config/plank ] && echo "[KOK:A12:son] skel plank ayari var" || echo "[KOK-UYARI:A12:son] skel plank ayari YOK"
[ -f /etc/skel/.config/xfce4/panel/whiskermenu-1.rc ] && echo "[KOK:A12:son] skel menu ayari var" || echo "[KOK-UYARI:A12:son] skel menu ayari YOK"
exit 0
