#!/bin/bash
# Kök: yuvarlak pencere köşeleri için picom'u güvenilir biçimde başlatır.
# Hata olursa nedenini ~/.local/state/kok/picom.log dosyasına yazar.
LOG="$HOME/.local/state/kok/picom.log"
CONF=/usr/share/kok/picom.conf
mkdir -p "$(dirname "$LOG")"
yaz() { echo "[$(date +%T)] $*" >> "$LOG"; }
yaz "kok-picom-baslat basladi (picom: $(command -v picom || echo YOK), surum: $(picom --version 2>&1 | head -1))"
command -v picom >/dev/null 2>&1 || { yaz "picom kurulu degil"; exit 1; }
pgrep -x picom >/dev/null && { yaz "picom zaten calisiyor"; exit 0; }
# Pencere yöneticisi (xfwm4) açılsın diye bekle (en fazla 20 sn)
for i in $(seq 1 20); do pgrep -x xfwm4 >/dev/null && break; sleep 1; done
# xfwm4'ün kendi kompozitörünü kapat ve bırakmasını bekle (en fazla 10 sn)
xfconf-query -c xfwm4 -p /general/use_compositing -s false >>"$LOG" 2>&1
for i in $(seq 1 10); do
  xprop -root _NET_WM_CM_S0 2>/dev/null | grep -q "window id" || break
  sleep 1
done
for deneme in 1 2 3; do
  case $deneme in
    1) EK="" ;;
    2) EK="--no-use-damage" ;;
    3) EK="--no-use-damage --no-fading-openclose" ;;
  esac
  yaz "deneme $deneme: picom --config $CONF $EK"
  nohup picom --config "$CONF" $EK >>"$LOG" 2>&1 &
  sleep 3
  if pgrep -x picom >/dev/null; then yaz "picom calisiyor (deneme $deneme)"; exit 0; fi
  yaz "deneme $deneme basarisiz"
  sleep 2
done
yaz "picom baslatilamadi; yerlesik kompozitore donuluyor"
xfconf-query -c xfwm4 -p /general/use_compositing -s true >>"$LOG" 2>&1
exit 1
