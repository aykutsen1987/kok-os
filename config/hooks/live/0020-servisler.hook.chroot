#!/bin/sh
KOK_ADIM="A2"; KOK_MOD="servisler"
echo "[KOK:$KOK_ADIM:$KOK_MOD] BASLADI"
trap 'k=$?; if [ $k -ne 0 ]; then echo "[KOK-HATA:$KOK_ADIM:$KOK_MOD] kod=$k"; else echo "[KOK:$KOK_ADIM:$KOK_MOD] TAMAM"; fi' EXIT
systemctl enable earlyoom.service || true
systemctl enable fstrim.timer || true
systemctl enable systemd-timesyncd.service || true
for s in ModemManager cups-browsed avahi-daemon; do
  systemctl disable "$s" 2>/dev/null || true
  systemctl mask "$s" 2>/dev/null || true
done
# picom paketi kendi otomatik başlatmasını getirir (varsayılan ayarlarla, eski ekran kartlarında çöker ve
# bizim başlatıcımızı engeller). Kapatıyoruz; picom'u yalnızca kok-picom-baslat başlatır.
printf '[Desktop Entry]\nType=Application\nName=picom\nHidden=true\n' > /etc/xdg/autostart/picom.desktop
echo "[KOK:$KOK_ADIM:$KOK_MOD] picom paket otomatik baslatmasi kapatildi"
# Açılışı yavaşlatan beklemeler: ağ hazır olana kadar bekleme ve gereksiz lxc servisleri (Waydroid bunlara ihtiyaç duymaz)
systemctl mask NetworkManager-wait-online.service 2>/dev/null || true
for s in lxc.service lxc-net.service lxc-monitord.service; do systemctl disable "$s" 2>/dev/null || true; done
# Açılış hızlandırma (eski disklerde apparmor 50 sn, ldconfig 25 sn, e2scrub 10 sn sürebiliyordu)
# 1) AppArmor profilleri arka planda yüklensin: açılışı (sysinit.target) beklemesin, düşük öncelikle çalışsın
mkdir -p /etc/systemd/system/apparmor.service.d
printf '[Unit]\nBefore=\n\n[Service]\nNice=10\n' > /etc/systemd/system/apparmor.service.d/kok-hizli.conf
# 2) Profil derlemesi daha hızlı olsun
if [ -f /etc/apparmor/parser.conf ]; then
  grep -q '^Optimize=' /etc/apparmor/parser.conf || echo 'Optimize=compress-fast' >> /etc/apparmor/parser.conf
fi
# 3) Gereksiz her açılış işi
systemctl mask e2scrub_reap.service 2>/dev/null || true
echo "[KOK:$KOK_ADIM:$KOK_MOD] acilis hizlandirma ayarlari yazildi"
exit 0
